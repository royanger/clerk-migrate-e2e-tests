{
  "name": "migration-test-apps",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "generate:users": "tsx scripts/generate-users.ts",
    "generate:users:10k": "tsx scripts/generate-users.ts --count 10000 --out data/users-10k.json",
    "generate:custom": "tsx scripts/generate-custom-exports.ts",
    "eval:users": "tsx scripts/eval/generate-eval-users.ts",
    "eval:provider-exports": "op run --env-file=op.env -- tsx scripts/eval/provider-exports.ts",
    "eval:imports:golden": "op run --env-file=op.env -- tsx scripts/eval/golden.ts",
    "eval:imports": "caffeinate -i op run --env-file=op.env -- tsx scripts/eval/imports.ts",
    "eval:migrations": "caffeinate -i op run --env-file=op.env -- tsx scripts/eval/migrations.ts",
    "seed": "op run --env-file=op.env -- tsx scripts/seed.ts",
    "reset": "op run --env-file=op.env -- tsx scripts/reset.ts",
    "teardown": "tsx scripts/teardown.ts",
    "check:env": "op run --env-file=op.env -- tsx scripts/check-env.ts",
    "supabase:sql": "op run --env-file=op.env -- tsx scripts/supabase-sql.ts",
    "db:tables": "op run --env-file=op.env -- tsx scripts/db-tables.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:migrate": "op run --env-file=op.env -- tsx scripts/test-migrate.ts",
    "test:migrate:all": "op run --env-file=op.env -- bash scripts/test-all.sh",
    "test:migrate:slice1": "tsx scripts/test-slice.ts 1",
    "test:migrate:slice2": "tsx scripts/test-slice.ts 2",
    "test:migrate:slice3": "tsx scripts/test-slice.ts 3",
    "test:migrate:slice4a": "tsx scripts/test-slice.ts 4a",
    "test:migrate:slice4b": "tsx scripts/test-slice.ts 4b",
    "test:migrate:slice4c": "tsx scripts/test-slice.ts 4c",
    "test:migrate:slice4d": "tsx scripts/test-slice.ts 4d",
    "test:migrate:slice4e": "tsx scripts/test-slice.ts 4e",
    "test:migrate:slice5": "tsx scripts/test-slice.ts 5",
    "test:migrate:slice6": "tsx scripts/test-slice.ts 6",
    "test:custom": "op run --env-file=op.env -- tsx scripts/test-custom-source.ts",
    "eval:sync-skill": "tsx scripts/eval/sync-skill.ts",
    "eval:ready": "op run --env-file=op.env -- tsx scripts/eval/ready.ts",
    "eval:sources": "caffeinate -i op run --env-file=op.env -- tsx scripts/eval/run.ts"
  },
  "devDependencies": {
    "@clerk/backend": "^3.17.0",
    "@faker-js/faker": "^10.6.0",
    "@libsql/client": "^0.18.0",
    "@supabase/supabase-js": "^2.112.4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26.4.1",
    "@workos-inc/node": "^10.13.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.2",
    "firebase-admin": "^13.10.0",
    "libphonenumber-js": "^1.13.14",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
